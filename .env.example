# ==========================================
# YOYO Mall 环境变量配置示例
# ==========================================
# 复制此文件为 .env.local 并填入实际值
# ==========================================

# ------------------------------------------
# 数据库配置 (必需)
# ------------------------------------------
# PostgreSQL 连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:password@localhost:5432/yoyo_mall"

# ------------------------------------------
# NextAuth 配置 (必需)
# ------------------------------------------
# 生成密钥: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
# 应用 URL
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------
# Stripe 支付配置 (必需)
# ------------------------------------------
# 开发环境使用 pk_test_ 和 sk_test_
# 生产环境使用 pk_live_ 和 sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key"
STRIPE_SECRET_KEY="sk_test_your_key"
# Webhook 密钥 (从 Stripe Dashboard 获取)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ------------------------------------------
# Resend 邮件服务配置 (Newsletter 功能必需)
# ------------------------------------------
# Resend API Key (从 https://resend.com 获取)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# 发件人邮箱 (必须使用已验证的域名邮箱)
RESEND_FROM_EMAIL="YOYO Mall <noreply@yourdomain.com>"
# 或使用测试域名 (仅开发环境): "YOYO Mall <onboarding@resend.dev>"

# ------------------------------------------
# 应用配置 (推荐)
# ------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YOYO Mall"
NEXT_PUBLIC_APP_VERSION="1.6.0"

# ------------------------------------------
# OSS 文件存储配置 (可选)
# ------------------------------------------
# 阿里云 OSS
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="your_access_key_id"
OSS_ACCESS_KEY_SECRET="your_access_key_secret"
OSS_BUCKET="yoyo-mall-images"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"

# 或使用 Cloudinary
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# ------------------------------------------
# Google Analytics (可选)
# ------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------
# SEO 配置 (可选)
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_VERIFICATION="your_verification_code"
NEXT_PUBLIC_YANDEX_VERIFICATION="your_verification_code"

# ------------------------------------------
# 邮件服务配置 (可选)
# ------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="YOYO Mall <noreply@yourdomain.com>"

# ------------------------------------------
# OAuth 配置 (可选)
# ------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# ------------------------------------------
# Redis 缓存配置 (可选)
# ------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# 开发环境配置
# ------------------------------------------
# 环境标识 (development, production, test)
NODE_ENV="development"

# 日志级别 (debug, info, warn, error)
LOG_LEVEL="debug"

# 是否启用性能监控
ENABLE_PERFORMANCE_MONITORING="true"

# ------------------------------------------
# 功能开关 (可选)
# ------------------------------------------
# 启用商品评价
ENABLE_REVIEWS="true"
# 启用心愿单
ENABLE_WISHLIST="true"
# 启用优惠券
ENABLE_COUPONS="true"
# 启用多语言
ENABLE_I18N="true"

# ------------------------------------------
# 速率限制配置 (可选)
# ------------------------------------------
RATE_LIMIT_WINDOW="60000" # 60秒
RATE_LIMIT_MAX_REQUESTS="100" # 最多100个请求

# ------------------------------------------
# 文件上传配置 (可选)
# ------------------------------------------
MAX_FILE_SIZE="5242880" # 5MB
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/gif"

# ------------------------------------------
# 安全配置 (可选)
# ------------------------------------------
# CORS 允许的域名
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Cookie 安全配置
SECURE_COOKIES="false" # 生产环境设为 true

# ------------------------------------------
# 第三方服务 (可选)
# ------------------------------------------
# Sentry 错误监控
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn"

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your_analytics_id"

# ------------------------------------------
# 备注
# ------------------------------------------
# 1. 所有 NEXT_PUBLIC_ 开头的变量会暴露给浏览器端
# 2. 没有 NEXT_PUBLIC_ 前缀的变量只在服务端可用
# 3. 必需的变量一定要配置，否则应用无法正常运行
# 4. 敏感信息请妥善保管，不要提交到代码仓库
# 5. 生产环境请使用强密码和真实的密钥

# ------------------------------------------
# 快速开始 (最小配置)
# ------------------------------------------
# 如果只是想快速测试项目，只需配置以下变量:
# - DATABASE_URL
# - NEXTAUTH_SECRET
# - NEXTAUTH_URL
# 其他变量可以暂时不配置或使用默认值
