# ==========================================
# Yobuy 环境变量配置
# ==========================================
# 从 .env.example 复制并修改
# ==========================================

# ------------------------------------------
# 数据库配置 (必需)
# ------------------------------------------
DATABASE_URL="your_database_url_here"

# ------------------------------------------
# NextAuth 配置 (必需)
# ------------------------------------------
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------
# Stripe 支付配置
# ------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_public_key"
STRIPE_SECRET_KEY="your_stripe_secret_key"

# ------------------------------------------
# Resend 邮件服务配置 (Newsletter 功能必需)
# ------------------------------------------
# 🚨 重要：Newsletter 功能需要配置以下变量
# 1. 访问 https://resend.com 注册账号
# 2. 获取 API Key (格式: re_xxxxxxxxxxxxx)
# 3. 配置发件人邮箱（测试阶段可使用 onboarding@resend.dev）

# Resend API Key - 从 https://resend.com/api-keys 获取
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# 发件人邮箱 - 测试阶段使用此邮箱（只能发送到你注册的邮箱）
RESEND_FROM_EMAIL="Yobuy <onboarding@resend.dev>"

# 生产环境使用已验证的域名邮箱
# RESEND_FROM_EMAIL="Yobuy <noreply@yourdomain.com>"

# ------------------------------------------
# 应用配置
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Yobuy"


